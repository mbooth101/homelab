## {{ ansible_managed }}

# Environment variables affecting the immich service component
#
# Documentation for all the supported env variables can be found here:
# https://immich.app/docs/install/environment-variables

IMMICH_ENV=production
IMMICH_BUILD_DATA=/usr/lib/immich
IMMICH_MEDIA_LOCATION=/var/lib/immich

# Listening interface
IMMICH_HOST=localhost
# Listening port
IMMICH_PORT={{ http_port }}

# Connection to immich machine learning service
IMMICH_MACHINE_LEARNING_ENABLED=true
IMMICH_MACHINE_LEARNING_URL=http://localhost:3003

# TZ is used by exiftool as a fallback in case the timezone cannot be
# determined from the image metadata. It is also used for logfile timestamps
# and cron job execution
TZ=Europe/London

# Number of cores available to the Immich server, auto-detected by default
CPU_CORES=2

# When DB_URL is defined, the DB_HOSTNAME, DB_PORT, DB_USERNAME, DB_PASSWORD
# and DB_DATABASE_NAME database variables are ignored
#DB_URL=
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_DATABASE_NAME={{ db_name }}

# When REDIS_URL or REDIS_SOCKET are defined, the REDIS_HOSTNAME, REDIS_PORT,
# REDIS_USERNAME, REDIS_PASSWORD, and REDIS_DBINDEX variables are ignored
#REDIS_URL=
#REDIS_SOCKET=
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DBINDEX=0
