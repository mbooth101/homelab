$ORIGIN {{ domain }}.
$TTL 5m

;Start of Authority Parameters: Serial, Refresh, Retry, Expire, Min TTL
@		IN	SOA	{{ host.fqdn }}. webmaster.{{ domain }}. ( {{ now(utc=true,fmt='%y%m%d%H%M') }} 1h 30m 24h 5m )
		IN	NS	{{ host.fqdn }}.

; This host
{{ host.name }}	IN	A	{{ host.ipv4.bond_ip }}
{{ host.name }}	IN	AAAA	{{ host.ipv6.bond_ip }}

; Gateway router
gateway		IN	A	{{ host.ipv4.gateway }}
gateway		IN	AAAA	{{ host.ipv6.gateway }}

; Service CNAMES
