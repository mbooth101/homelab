$ORIGIN {{ host.ipv4.cidr | ip_ptr }}.
$TTL 3600      ; 1 hour

;Start of Authority Parameters: Serial, Refresh, Retry, Expire, Min TTL
@	IN	SOA	{{ host.fqdn }}.  webmaster.{{ domain }}. ( 0 1h 30m 24h 5m )
	IN	NS	{{ host.fqdn }}.

; This host
10	IN	PTR	{{ host.fqdn }}.

; Gateway router
1	IN	PTR	gateway.{{ domain }}.
