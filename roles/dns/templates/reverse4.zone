$ORIGIN {{ host.cidr4 | ip_ptr }}.
$TTL 5m

;Start of Authority Parameters: Serial, Refresh, Retry, Expire, Min TTL
@	IN	SOA	{{ host.fqdn }}.  webmaster.{{ domain }}. ( {{ now(utc=true,fmt='%y%m%d%H%M') }} 1h 30m 24h 5m )
	IN	NS	{{ host.fqdn }}.

; This host
10	IN	PTR	{{ host.fqdn }}.

; Gateway router
1	IN	PTR	gateway.{{ domain }}.

; Managed switch
2	IN	PTR	switch.{{ domain }}.
