; {{ ansible_managed }}

; Local SELinux policy additions for ZoneMinder

; Allow ZoneMinder zmc processes to connects to the cameras over RTSP
(allow zoneminder_t rtsp_port_t (tcp_socket (name_connect)))

; ZoneMinder runs "uptime" only to parse the load average, but uptime also
; reads logind's sessions to count logged-in users. ZoneMinder ignores that
; count, so silence the denials rather than allowing the access. When it can't
; read the sessions, uptime falls back to counting users from /run/utmp
; (initrc_var_run_t), so silence that too
(dontaudit zoneminder_t systemd_logind_sessions_t (dir (read)))
(dontaudit zoneminder_t systemd_logind_sessions_t (file (read open getattr)))
(dontaudit zoneminder_t initrc_var_run_t (file (read open getattr lock)))

; selinux-policy doesn't label ZoneMinder's web cache directory, so it would
; fall back to var_t, but needs to be httpd_cache_t in order for ZoneMinder
; to write to it
(filecon "/var/cache/zoneminder(/.*)?" any (system_u object_r httpd_cache_t ((s0) (s0))))

; ZoneMinder maps event snapshots to generate thumbnails, allow httpd to
; mmap() files labelled zoneminder_var_lib_t
(allow httpd_t zoneminder_var_lib_t (file (map)))

; Live view and event playback using the nph-zms CGI process

; Allow ZoneMinder scripts to talk to Apache over a unix socket
(allow zoneminder_script_t httpd_t (unix_dgram_socket (sendto)))
; Allow ZoneMinder scripts to find and write its own per-monitor and per-event
; logs in ZoneMinder log labelled directories
(allow zoneminder_script_t zoneminder_log_t (dir (search write add_name)))
(allow zoneminder_script_t zoneminder_log_t (file (create open append getattr)))
